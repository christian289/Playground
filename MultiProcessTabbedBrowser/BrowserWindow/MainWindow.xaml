<Window x:Class="BrowserWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser Window" Height="700" Width="1100"
        MinHeight="400" MinWidth="600"
        Background="#1A1A2E"
        WindowStyle="None"
        AllowsTransparency="False"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar (hidden when embedded) -->
            <RowDefinition Height="Auto"/>  <!-- Tab bar (hidden when embedded) -->
            <RowDefinition Height="*"/>     <!-- Content area -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border x:Name="TitleBarArea" Grid.Row="0" Background="#16162A" Padding="8,6"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x25C8;" Foreground="#6C63FF" FontSize="16" Margin="4,0,8,0"/>
                    <TextBlock x:Name="TitleText" Text="Browser Window" Foreground="#AAAACC"
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PidDisplay" Foreground="#5D5D8C" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x2500;" Width="40" Height="28" FontSize="14"
                            Background="Transparent" Foreground="#8888AA" BorderThickness="0"
                            Click="MinimizeButton_Click"/>
                    <Button Content="&#x25A1;" Width="40" Height="28" FontSize="12"
                            Background="Transparent" Foreground="#8888AA" BorderThickness="0"
                            Click="MaximizeButton_Click"/>
                    <Button Content="&#x2715;" Width="40" Height="28" FontSize="12"
                            Background="Transparent" Foreground="#8888AA" BorderThickness="0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Bar -->
        <Border x:Name="TabBarArea" Grid.Row="1" Background="#1E1E38" Padding="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabBar" Orientation="Horizontal"/>
                </ScrollViewer>

                <Button Grid.Column="1" Content="+" Width="32" Height="28"
                        FontSize="18" FontWeight="Light"
                        Background="Transparent" Foreground="#8888AA"
                        BorderThickness="0" Margin="4,0"
                        ToolTip="New Window (Ctrl+N)"
                        Click="NewWindowButton_Click"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <!-- Local Content (visible when "self" tab is active) -->
            <Grid x:Name="LocalContent">
                <!-- Address Bar -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#2D2D44" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="&#x25C0;" Width="32" Height="28" Margin="0,0,4,0"
                                Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                FontSize="12" Click="BackButton_Click"/>
                        <Button Grid.Column="1" Content="&#x25B6;" Width="32" Height="28" Margin="0,0,4,0"
                                Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                FontSize="12" Click="ForwardButton_Click"/>
                        <Button Grid.Column="2" Content="&#x21BB;" Width="32" Height="28" Margin="0,0,8,0"
                                Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                FontSize="14" Click="RefreshButton_Click"/>

                        <TextBox Grid.Column="3" x:Name="AddressBar" Height="28"
                                 Background="#1A1A2E" Foreground="White" BorderBrush="#5D5D8C"
                                 Padding="8,4" FontSize="13" VerticalContentAlignment="Center"
                                 KeyDown="AddressBar_KeyDown" Text="about:blank"/>

                        <Button Grid.Column="4" Content="Go" Width="50" Height="28" Margin="8,0,0,0"
                                Background="#6C63FF" Foreground="White" BorderBrush="#6C63FF"
                                FontWeight="Bold" Click="GoButton_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#282840">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock x:Name="PageTitle" Text="New Window"
                                       Foreground="White" FontSize="28" FontWeight="Bold"
                                       Margin="0,20,0,10"/>
                            <TextBlock x:Name="PageContent"
                                       Text="Navigate to a URL to get started."
                                       Foreground="#AAAACC" FontSize="14" TextWrapping="Wrap"
                                       LineHeight="22"/>

                            <!-- Process Info -->
                            <Border Background="#1A1A2E" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Process Information" Foreground="#6C63FF"
                                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="ProcessInfo" Foreground="#8888AA" FontSize="12"
                                               FontFamily="Consolas" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Quick Links -->
                            <TextBlock Text="Quick Links" Foreground="White" FontSize="18"
                                       FontWeight="SemiBold" Margin="0,30,0,10"/>
                            <WrapPanel>
                                <Button Content="Page A" Margin="0,0,8,8" Padding="16,8"
                                        Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                        Tag="http://example.com/a" Click="QuickLink_Click"/>
                                <Button Content="Page B" Margin="0,0,8,8" Padding="16,8"
                                        Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                        Tag="http://example.com/b" Click="QuickLink_Click"/>
                                <Button Content="Settings" Margin="0,0,8,8" Padding="16,8"
                                        Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                        Tag="chrome://settings" Click="QuickLink_Click"/>
                            </WrapPanel>

                            <!-- Dock into another window -->
                            <Border Background="#1A1A2E" CornerRadius="8" Padding="16" Margin="0,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="Dock into another Window" Foreground="#6C63FF"
                                               FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <TextBlock Text="Enter the target window's PID to dock this window as a tab."
                                               Foreground="#8888AA" FontSize="12" TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="AvailablePeersText" Foreground="#5D5D8C"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox x:Name="TargetPidInput" Width="120" Height="28"
                                                 Background="#282840" Foreground="White"
                                                 BorderBrush="#5D5D8C" Padding="8,4" FontSize="13"
                                                 VerticalContentAlignment="Center"/>
                                        <Button Content="Dock" Width="80" Height="28" Margin="8,0,0,0"
                                                Background="#6C63FF" Foreground="White"
                                                BorderBrush="#6C63FF" FontWeight="Bold"
                                                Click="DockButton_Click"/>
                                        <Button Content="Refresh" Width="80" Height="28" Margin="8,0,0,0"
                                                Background="#3D3D5C" Foreground="White"
                                                BorderBrush="#5D5D8C"
                                                Click="RefreshPeersButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Hosted Tab Content Area (visible when a hosted peer tab is active) -->
            <Border x:Name="HostedContent" Background="#282840" Visibility="Collapsed"
                    ClipToBounds="True"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#16162A" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Text="Ready" Foreground="#5D5D8C" FontSize="11"/>
                <TextBlock x:Name="ModeText" Grid.Column="1"
                           Text="Standalone" Foreground="#44AA44" FontSize="11" Margin="20,0"/>
                <TextBlock x:Name="TabCountText" Grid.Column="2"
                           Text="1 tab" Foreground="#5D5D8C" FontSize="11" Margin="20,0"/>
                <TextBlock x:Name="ProcessCountText" Grid.Column="3"
                           Text="1 process" Foreground="#5D5D8C" FontSize="11" Margin="20,0"/>
                <TextBlock x:Name="MemoryText" Grid.Column="4"
                           Text="" Foreground="#5D5D8C" FontSize="11" Margin="20,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
