<Window x:Class="TabHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi-Process Browser" Height="700" Width="1100"
        MinHeight="400" MinWidth="600"
        Background="#1A1A2E"
        WindowStyle="None"
        AllowsTransparency="False"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 제목 표시줄 -->
            <RowDefinition Height="Auto"/>  <!-- 탭 바 -->
            <RowDefinition Height="*"/>     <!-- 컨텐츠 영역 -->
            <RowDefinition Height="Auto"/>  <!-- 상태 바 -->
        </Grid.RowDefinitions>

        <!-- 커스텀 제목 표시줄 -->
        <Border Grid.Row="0" Background="#16162A" Padding="8,6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x25C8;" Foreground="#6C63FF" FontSize="16" Margin="4,0,8,0"/>
                    <TextBlock Text="Multi-Process Browser" Foreground="#AAAACC" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#x2500;" Width="40" Height="28" FontSize="14"
                            Background="Transparent" Foreground="#8888AA" BorderThickness="0"
                            Click="MinimizeButton_Click"/>
                    <Button Content="&#x25A1;" Width="40" Height="28" FontSize="12"
                            Background="Transparent" Foreground="#8888AA" BorderThickness="0"
                            Click="MaximizeButton_Click"/>
                    <Button x:Name="CloseButton" Content="&#x2715;" Width="40" Height="28" FontSize="12"
                            Background="Transparent" Foreground="#8888AA" BorderThickness="0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 탭 바 -->
        <Border Grid.Row="1" Background="#1E1E38" Padding="4,4,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 탭 목록 -->
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabBar" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- 새 탭 버튼 -->
                <Button Grid.Column="1" Content="+" Width="32" Height="28"
                        FontSize="18" FontWeight="Light"
                        Background="Transparent" Foreground="#8888AA"
                        BorderThickness="0" Margin="4,0"
                        ToolTip="New Tab (Ctrl+T)"
                        Click="NewTabButton_Click"/>
            </Grid>
        </Border>

        <!-- 컨텐츠 호스트 영역 (자식 프로세스 윈도우가 여기에 임베딩됨) -->
        <Border Grid.Row="2" x:Name="ContentHost" Background="#282840"
                ClipToBounds="True">
            <Grid x:Name="ContentGrid">
                <!-- 탭이 없을 때 표시되는 기본 화면 -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="&#x25C8;" Foreground="#3D3D5C" FontSize="64"
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Multi-Process Tabbed Browser"
                               Foreground="#5D5D8C" FontSize="24" FontWeight="Light"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Click '+' or press Ctrl+T to create a new tab"
                               Foreground="#4D4D6C" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Each tab runs in its own process for isolation"
                               Foreground="#3D3D5C" FontSize="12"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Drag a tab out to detach it as a standalone window"
                               Foreground="#3D3D5C" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="3" Background="#16162A" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Text="Ready" Foreground="#5D5D8C" FontSize="11"/>
                <TextBlock x:Name="TabCountText" Grid.Column="1"
                           Text="0 tabs" Foreground="#5D5D8C" FontSize="11" Margin="20,0"/>
                <TextBlock x:Name="ProcessCountText" Grid.Column="2"
                           Text="0 processes" Foreground="#5D5D8C" FontSize="11" Margin="20,0"/>
                <TextBlock x:Name="MemoryText" Grid.Column="3"
                           Text="" Foreground="#5D5D8C" FontSize="11" Margin="20,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
