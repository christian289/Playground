<Window x:Class="TabChild.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tab Child" Height="600" Width="900"
        Background="#1E1E2E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 주소 표시줄 -->
        <Border Grid.Row="0" Background="#2D2D44" Padding="8" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="&#x25C0;" Width="32" Height="28" Margin="0,0,4,0"
                        Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                        FontSize="12" Click="BackButton_Click"/>
                <Button Grid.Column="1" Content="&#x25B6;" Width="32" Height="28" Margin="0,0,4,0"
                        Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                        FontSize="12" Click="ForwardButton_Click"/>
                <Button Grid.Column="2" Content="&#x21BB;" Width="32" Height="28" Margin="0,0,8,0"
                        Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                        FontSize="14" Click="RefreshButton_Click"/>

                <TextBox Grid.Column="3" x:Name="AddressBar" Height="28"
                         Background="#1A1A2E" Foreground="White" BorderBrush="#5D5D8C"
                         Padding="8,4" FontSize="13" VerticalContentAlignment="Center"
                         KeyDown="AddressBar_KeyDown"
                         Text="about:blank"/>

                <Button Grid.Column="4" Content="Go" Width="50" Height="28" Margin="8,0,0,0"
                        Background="#6C63FF" Foreground="White" BorderBrush="#6C63FF"
                        FontWeight="Bold" Click="GoButton_Click"/>
            </Grid>
        </Border>

        <!-- 컨텐츠 영역 (간단한 HTML 렌더링 시뮬레이션) -->
        <Border Grid.Row="1" Background="#282840" Margin="0">
            <Grid>
                <!-- 실제 브라우저 대신 시뮬레이션 UI -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentArea" Margin="20">
                        <TextBlock x:Name="PageTitle" Text="New Tab"
                                   Foreground="White" FontSize="28" FontWeight="Bold"
                                   Margin="0,20,0,10"/>
                        <TextBlock x:Name="PageContent" Text="Navigate to a URL to get started."
                                   Foreground="#AAAACC" FontSize="14" TextWrapping="Wrap"
                                   LineHeight="22"/>

                        <Border Background="#1A1A2E" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="Process Information" Foreground="#6C63FF"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock x:Name="ProcessInfo" Foreground="#8888AA" FontSize="12"
                                           FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Links -->
                        <TextBlock Text="Quick Links" Foreground="White" FontSize="18"
                                   FontWeight="SemiBold" Margin="0,30,0,10"/>
                        <WrapPanel>
                            <Button Content="Page A" Margin="0,0,8,8" Padding="16,8"
                                    Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                    Tag="http://example.com/a" Click="QuickLink_Click"/>
                            <Button Content="Page B" Margin="0,0,8,8" Padding="16,8"
                                    Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                    Tag="http://example.com/b" Click="QuickLink_Click"/>
                            <Button Content="Page C" Margin="0,0,8,8" Padding="16,8"
                                    Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                    Tag="http://example.com/c" Click="QuickLink_Click"/>
                            <Button Content="Settings" Margin="0,0,8,8" Padding="16,8"
                                    Background="#3D3D5C" Foreground="White" BorderBrush="#5D5D8C"
                                    Tag="chrome://settings" Click="QuickLink_Click"/>
                        </WrapPanel>

                        <!-- Attach to Host (standalone 모드에서만 표시) -->
                        <Border x:Name="AttachPanel" Background="#1A1A2E" CornerRadius="8"
                                Padding="16" Margin="0,20,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Attach to Host Window" Foreground="#6C63FF"
                                           FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Enter the Host process PID to merge this tab into a host window."
                                           Foreground="#8888AA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="HostPidInput" Width="120" Height="28"
                                             Background="#282840" Foreground="White" BorderBrush="#5D5D8C"
                                             Padding="8,4" FontSize="13" VerticalContentAlignment="Center"/>
                                    <Button Content="Attach" Width="80" Height="28" Margin="8,0,0,0"
                                            Background="#6C63FF" Foreground="White" BorderBrush="#6C63FF"
                                            FontWeight="Bold" Click="AttachButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 상태 표시줄 -->
        <Border Grid.Row="2" Background="#2D2D44" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0"
                           Text="Ready" Foreground="#8888AA" FontSize="11"/>
                <TextBlock x:Name="ProcessIdText" Grid.Column="1"
                           Foreground="#6C63FF" FontSize="11" Margin="10,0"/>
                <TextBlock x:Name="ConnectionStatus" Grid.Column="2"
                           Text="Standalone" Foreground="#44AA44" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
