<Application x:Class="Pretext.Wpf.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- shared-aeVaPDaJ.css palette -->
        <SolidColorBrush x:Key="Brush.Background" Color="#0A0A0A" />
        <SolidColorBrush x:Key="Brush.NavBorder" Color="#1A1A1A" />
        <SolidColorBrush x:Key="Brush.Text" Color="#E5E5E5" />
        <SolidColorBrush x:Key="Brush.TextDim" Color="#999999" />
        <SolidColorBrush x:Key="Brush.TextFaint" Color="#666666" />
        <SolidColorBrush x:Key="Brush.Accent" Color="#FF8844" />
        <SolidColorBrush x:Key="Brush.AccentBorder" Color="#FF6600" />
        <SolidColorBrush x:Key="Brush.ControlBorder" Color="#333333" />
        <SolidColorBrush x:Key="Brush.PanelBackground" Color="#F20E0E0E" />
        <SolidColorBrush x:Key="Brush.PanelBorder" Color="#262626" />
        <SolidColorBrush x:Key="Brush.ChipBackground" Color="#D9141414" />

        <!-- .tab-link -->
        <Style x:Key="TabLink" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="16,8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#AAAAAA" />
                                <Setter TargetName="Chrome" Property="Background" Value="#0AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FF8844" />
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFF6600" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .scene-btn / .preset-btn item containers -->
        <Style x:Key="ChipListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SceneChip" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="{StaticResource Brush.ChipBackground}"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CCCCCC" />
                                <Setter TargetName="Chrome" Property="Background" Value="#F21E1E1E" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FF8844" />
                                <Setter TargetName="Chrome" Property="Background" Value="#26FF6600" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF6600" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChip"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource SceneChip}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="#08FFFFFF"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CCCCCC" />
                                <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FF8844" />
                                <Setter TargetName="Chrome" Property="Background" Value="#26FF6600" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF6600" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- panel slider -->
        <Style x:Key="SliderRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" VerticalAlignment="Center">
                            <Border Height="4"
                                    Background="#333333"
                                    CornerRadius="2"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                                  Style="{StaticResource SliderRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                                  Style="{StaticResource SliderRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Dot"
                                                         Fill="#888888"
                                                         Stroke="#0A0A0A"
                                                         StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Fill" Value="#AAAAAA" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .toggle -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="36" Height="20">
                            <Border x:Name="Track"
                                    Background="#333333"
                                    CornerRadius="10" />
                            <Ellipse x:Name="Dot"
                                     Width="16"
                                     Height="16"
                                     Margin="2,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="#888888" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF6600" />
                                <Setter TargetName="Dot" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="Dot" Property="Margin" Value="18,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- panel text bits -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        </Style>

        <Style x:Key="ControlLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ControlValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- #panel-toggle -->
        <Style x:Key="PanelToggleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Width="36"
                                Height="36"
                                Background="{StaticResource Brush.ChipBackground}"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CCCCCC" />
                                <Setter TargetName="Chrome" Property="Background" Value="#F21E1E1E" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#555555" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- panel close button -->
        <Style x:Key="PanelCloseButton" TargetType="Button">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Width="28"
                                Height="28"
                                Background="Transparent"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#AAAAAA" />
                                <Setter TargetName="Chrome" Property="Background" Value="#0DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Layout Lab dark inputs -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#141414" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="SelectionBrush" Value="#66FF6600" />
        </Style>

    </Application.Resources>
</Application>
