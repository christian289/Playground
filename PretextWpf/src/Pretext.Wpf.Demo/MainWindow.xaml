<Window x:Class="Pretext.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Pretext.Wpf.Demo.Controls"
        Title="Pretext.Wpf — layout surface"
        Width="900"
        Height="620"
        FontFamily="Segoe UI"
        FontSize="15">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox x:Name="SourceText"
                 Grid.Row="0"
                 AcceptsReturn="True"
                 Height="96"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <Grid Grid.Row="1" Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Width" />
            <Slider x:Name="WidthSlider"
                    Grid.Column="1"
                    Margin="8,0"
                    Minimum="80"
                    Maximum="840"
                    Value="520"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       MinWidth="48"
                       Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat={}{0:F0} px}" />

            <TextBlock Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Center" Text="Letter spacing" />
            <Slider x:Name="LetterSpacingSlider"
                    Grid.Column="4"
                    Margin="8,0"
                    Minimum="0"
                    Maximum="6"
                    Value="0"
                    VerticalAlignment="Center" />
            <TextBlock Grid.Column="5"
                       VerticalAlignment="Center"
                       MinWidth="90"
                       Text="{Binding ElementName=Surface, Path=LineCount, StringFormat={}{0} lines}" />
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#FFBFBFBF"
                BorderThickness="1"
                Padding="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="{Binding ElementName=WidthSlider, Path=Value}">
            <controls:PretextTextSurface x:Name="Surface"
                                         Text="{Binding ElementName=SourceText, Path=Text}"
                                         LetterSpacing="{Binding ElementName=LetterSpacingSlider, Path=Value}"
                                         Foreground="#FF101010" />
        </Border>
    </Grid>
</Window>
