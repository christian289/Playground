<Window x:Class="Pretext.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pretext.Wpf.Demo.Views"
        Title="Pretext Playground"
        Width="1280"
        Height="840"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- #tab-nav -->
        <Border DockPanel.Dock="Top"
                Height="44"
                Padding="16,0"
                Background="{StaticResource Brush.Background}"
                BorderBrush="{StaticResource Brush.NavBorder}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton x:Name="DragonTab"
                                 Content="Dragon"
                                 GroupName="Nav"
                                 IsChecked="True"
                                 Style="{StaticResource TabLink}"
                                 Checked="OnTabChecked" />
                    <RadioButton x:Name="AsciiTab"
                                 Content="ASCII Animations"
                                 GroupName="Nav"
                                 Margin="2,0,0,0"
                                 Style="{StaticResource TabLink}"
                                 Checked="OnTabChecked" />
                    <RadioButton x:Name="LabTab"
                                 Content="Layout Lab"
                                 GroupName="Nav"
                                 Margin="2,0,0,0"
                                 Style="{StaticResource TabLink}"
                                 Checked="OnTabChecked" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Text="PRETEXT PLAYGROUND" />
            </DockPanel>
        </Border>

        <Grid>
            <views:DragonView x:Name="DragonPage" />
            <views:AsciiView x:Name="AsciiPage" Visibility="Collapsed" />
            <views:LayoutLabView x:Name="LabPage" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
